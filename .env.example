# Copy to .env for a VPS / Docker run. NEVER commit the real .env.
WLB_ENV=production
WLB_SECRET_KEY=change-me-to-64-random-characters
WLB_DATABASE_URL=postgresql://erp_user:password@localhost:5432/erp
WLB_ADMIN_PASSWORD=ChangeMe123
# Public employee self-registration: 1 = on (default), 0 = off; signups per IP per hour
# WLB_ALLOW_REGISTRATION=1
# WLB_REGISTER_LIMIT=5
# Optional: create demo people on first start (showcase sites only)
# WLB_SEED_DEMO=1
# WLB_DEMO_PASSWORD=SomethingStrong1
